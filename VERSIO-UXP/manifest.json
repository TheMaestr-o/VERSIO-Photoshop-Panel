{
    "manifestVersion": 5,
    "id": "com.maestro.versio",
    "name": "VERSIO",
    "version": "1.0.0",
    "main": "index.html",
    "host": {
        "app": "PS",
        "minVersion": "24.0.0",
        "data": {
            "apiVersion": 2
        }
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "versioPanel",
            "label": {
                "default": "VERSIO"
            },
            "minimumSize": {
                "width": 300,
                "height": 550
            },
            "maximumSize": {
                "width": 300,
                "height": 550
            },
            "preferredDockedSize": {
                "width": 300,
                "height": 550
            },
            "preferredFloatingSize": {
                "width": 300,
                "height": 550
            },
            "icons": [
                {
                    "width": 23,
                    "height": 23,
                    "path": "icons/icon.png",
                    "scale": [
                        1,
                        2
                    ],
                    "theme": [
                        "darkest",
                        "dark",
                        "medium",
                        "lightest",
                        "light",
                        "all"
                    ]
                }
            ]
        }
    ],
    "requiredPermissions": {
        "network": {
            "domains": [
                "https://app.sdarm.org",
                "https://api.dictionaryapi.dev",
                "https://en.wiktionary.org"
            ]
        }
    },
    "icons": [
        {
            "width": 48,
            "height": 48,
            "path": "icons/icon48.png",
            "scale": [
                1,
                2
            ],
            "theme": [
                "darkest",
                "dark",
                "medium",
                "lightest",
                "light",
                "all"
            ],
            "species": [
                "pluginList"
            ]
        }
    ]
}
